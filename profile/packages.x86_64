sddm-kcm
# Icon theme of the monOS Global Theme (Papirus-Dark)
papirus-icon-theme
# Boot splash (theme "monos", see /usr/share/plymouth/themes/monos)
plymouth
dolphin
kate
spectacle
ark
okular
gwenview
filelight
haruna
discover
flatpak
plasma-systemmonitor
# KDE essentials: Dolphin plugins (git, mounts), extra KIO workers (sftp, smb,
# thumbnails, ...), thumbnails for documents and videos, admin:// in Dolphin,
# Plasma widgets, phone integration, partition editor, calculator and the
# browser integration (media controls, downloads in notifications)
dolphin-plugins
kio-extras
kdegraphics-thumbnailers
ffmpegthumbs
kio-admin
kdeplasma-addons
kdeconnect
partitionmanager
kcalc
plasma-browser-integration

# --- Terminal ---
# kitty is the default; foot is the fallback because kitty needs
# OpenGL 3.3 and fails in VMs without 3D acceleration.
kitty
foot

# --- Hardware / system support ---
networkmanager
bluez
bluez-utils
pipewire
pipewire-pulse
pipewire-alsa
# pipewire-jack satisfies the 'jack' virtual dependency (otherwise jack2 is pulled)
pipewire-jack
wireplumber
sof-firmware
mesa
vulkan-radeon
vulkan-intel
power-profiles-daemon
zram-generator
# Firmware updates (LVFS, shown in Discover), firewall (ufw, enabled with
# deny incoming / allow outgoing; Plasma's Firewall settings page) and printing
# (CUPS, socket-activated; Plasma's printer settings). cups-pdf is not
# installed: the Qt, GTK and Firefox print dialogs already print to PDF.
fwupd
ufw
plasma-firewall
cups
print-manager
pacman-contrib
xdg-user-dirs
noto-fonts
noto-fonts-emoji
# Chinese/Japanese/Korean glyphs, and metric-compatible Arial/Times/Courier
noto-fonts-cjk
ttf-liberation
ttf-jetbrains-mono-nerd
# GStreamer: PipeWire source/sink and FFmpeg decoders (Qt Multimedia, thumbnails)
gst-plugin-pipewire
gst-libav
# English OCR data for Spectacle (otherwise the first 'tessdata' provider, Afrikaans, is picked)
tesseract-data-eng

# --- Graphics drivers ---
# Mesa (above) covers AMD, Intel and nouveau. intel-media-driver: VA-API video
# decoding on Intel Broadwell and newer; thermald: Intel thermal daemon.
# NVIDIA: open kernel modules (Turing / GTX 16xx / RTX 20xx and newer) for both
# kernels, userspace and VA-API (libva-nvidia-driver). On the live session
# nouveau stays usable for older NVIDIA GPUs (see /etc/modprobe.d/
# monos-nouveau-gate.conf); the installer removes what the machine does not
# need (/etc/calamares/scripts/monos-hardware-cleanup.sh).
intel-media-driver
thermald
nvidia-open
nvidia-open-lts
nvidia-utils
libva-nvidia-driver

