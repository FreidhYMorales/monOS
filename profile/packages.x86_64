zsh-autosuggestions
zsh-syntax-highlighting
zsh-completions
# Shell history search (Ctrl-R, local only) and per-directory .envrc
atuin
direnv
# yazi previewers and plugin dependencies (see etc/skel/.config/yazi):
# glow (Markdown), hexyl (binaries), mediainfo (media metadata), 7zip and
# poppler (archives/PDF), imagemagick and resvg (images/SVG/fonts),
# trash-cli (recycle-bin plugin), wl-clipboard (clipboard plugin),
# gvfs + gvfs-mtp (gvfs plugin: phones and network shares)
glow
hexyl
mediainfo
7zip
poppler
imagemagick
resvg
trash-cli
wl-clipboard
gvfs
gvfs-mtp

# --- Applications ---
firefox
# Markdown notes (monOS theme applied to every vault, see
# /usr/local/bin/monos-obsidian-theme-sync)
obsidian

# --- Installer (Calamares) ---
# calamares, ckbcomp and yay-bin come from the local [monos] repository
# (AUR packages built by aur/build.sh). The installer copies this live
# root filesystem to disk, so everything below also ends up installed.
calamares
ckbcomp
yay-bin

# --- Desktop theming from the local [monos] repository (AUR, aur/build.sh) ---
# Yamis monochrome icons (icon theme of the monOS Global Theme)
yamis-icon-theme-git
# Klassy: application style and window decoration
klassy
# Bibata cursors (Bibata-Modern-Ice is the default)
bibata-cursor-theme-bin
# Krohnkite dynamic tiling KWin script (installed, disabled by default)
kwin-scripts-krohnkite
# Panel Colorizer: draws the top bar islands and the dock surface (third-party
# widget; the panels still work, unstyled, if it breaks after a Plasma update)
plasma6-applets-panel-colorizer
# Kara: GNOME-style virtual desktop pill and dots in the top bar (third-party
# widget; the layout falls back to the stock pager when it is missing)
plasma6-applets-kara
# Window Title: active window icon and name in the top bar (third-party widget,
# skipped by the layout when missing)
plasma6-applets-window-title

# --- Installed system: kernels, boot and snapshots ---
# linux-lts is a fallback kernel. mkarchiso copies every /boot/vmlinuz-* to
# the ISO; the installer restores them from /usr/lib/modules (see
# profile/airootfs/etc/calamares/scripts/monos-target-cleanup.sh).
linux-lts
os-prober
snapper
snap-pac
grub-btrfs
# grub-btrfsd (snapshot watcher) needs inotifywait
inotify-tools
